# Copie para .env:  cp .env.example .env

# ---- Banco (PostgreSQL do docker compose) ----
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora
POSTGRES_DB=aurora
# Fora do Docker (rodando o uvicorn local), use localhost; no compose o host é sobrescrito para "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- LLM ----
# openai = classificação, extração de parâmetros e respostas com LLM + embeddings no RAG
# none   = modo determinístico (regras + SQL + busca lexical), não precisa de chave
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcional: endpoint compatível com a API da OpenAI
OPENAI_BASE_URL=
LLM_TIMEOUT_S=30

# ---- Orquestrador / RAG ----
ROUTER_MIN_CONFIDENCE=0.6
RAG_TOP_K=4

# ---- API ----
API_PORT=8000
INGEST_ON_STARTUP=true
LOG_LEVEL=INFO
